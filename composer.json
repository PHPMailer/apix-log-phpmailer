{
  "name": "phpmailer/apix-log-phpmailer",
  "description": "A PHPMailer logger for APIx Log",
  "type": "library",
  "minimum-stability": "stable",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Marcus Bointon",
      "email": "phpmailer@synchromedia.co.uk"
    },
    {
      "name": "Franck Cassedanne",
      "email": "franck@ouarz.net"
    }
  ],
  "require": {
    "php": "^8.4.0",
    "apix/log": "^1.3.0",
    "phpmailer/phpmailer": "^7.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.6",
    "phpstan/phpstan": "^2.3.4"
  },
  "autoload": {
    "psr-4": { "Apix\\Log\\Logger\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Apix\\Log\\Logger\\tests\\": "tests/" }
  },
  "provide": {
    "psr/log-implementation": "1.0.0"
  }
}
